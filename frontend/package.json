{
  "name": "text-to-svg-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/writeRoutes.js",
    "check-types": "tsc --noEmit",
    "dev": "vite",
    "preview": "vite preview --host 0.0.0.0",
    "test-e2e": "playwright test",
    "test-e2e-ui": "playwright test --ui",
    "test-only": "vitest run --coverage",
    "test-watch": "vitest"
  },
  "dependencies": {
    "@blueprintjs/core": "^6.18.0",
    "@blueprintjs/icons": "^6.13.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/state": "^6.7.1",
    "@preact/signals-react": "^3.12.0",
    "codemirror": "^6.0.2",
    "mathjax-full": "^3.2.2",
    "react": "^19.2.8",
    "react-cheminfo": "^0.2.0",
    "react-dom": "^19.2.8",
    "react-science": "^23.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "@zakodium/tsconfig": "^1.0.5",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "volta": {
    "extends": "../package.json"
  }
